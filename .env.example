# Example environment overrides. Copy to `.env` (gitignored) and adjust.
# These override individual settings on top of whichever configs/*.yaml
# loads - see src/recommendation/utils/config.py: _ENV_OVERRIDES for the
# authoritative list.
#
# Everything here is a non-sensitive operational knob EXCEPT the two
# service-auth credentials at the bottom, which are the only secrets this
# project consumes. They are read straight from the environment by
# src/recommendation/data/backend/auth.py and are deliberately NOT fields
# on BackendApiConfig - config is loaded from committed YAML and dumped in
# diagnostics. Never commit a real value: `.env` is gitignored, this file
# carries placeholders only.

# --- Which config file / data source ---
# RECS_CONFIG_PATH=configs/base.yaml
# RECS_DATA_SOURCE=sqlite            # synthetic | sqlite | backend_api
# RECS_MODELS_DIR=models
# RECS_LOG_LEVEL=INFO
# RECS_RETRIEVAL_BACKEND=faiss       # faiss | scann
# RECS_REFRESH_INTERVAL_SECONDS=30

# --- Real backend REST API (only used when RECS_DATA_SOURCE=backend_api) ---
# docs/data-mapping.md section 19. /api/products, /api/categories and
# /api/user-activities are public; /api/users/{guid} and /api/reviews are
# Bearer-gated (see the service credentials below).
# RECS_BACKEND_API_BASE_URL=https://your-backend.example.com
# RECS_BACKEND_API_TIMEOUT=30
# RECS_BACKEND_API_PAGE_SIZE=100
# TLS verification is ON by default and MUST stay on in production. Set to
# false ONLY for a local dev backend with a self-signed / IP-mismatched
# certificate:
# RECS_BACKEND_TLS_VERIFY=false

# --- Backend service-to-service credentials (SECRET - placeholders only) ---
# Redeemed at POST /api/auth/service/token for a ~15-minute Bearer token,
# used ONLY for the gated endpoints (/api/users/{guid}, /api/reviews). Leave
# both unset and those endpoints are skipped cleanly: profiles stay bare and
# reviews stay empty, which the pipeline already tolerates. The token is
# cached in memory only - never written to disk, never logged.
# RECS_BACKEND_SERVICE_CLIENT_ID=your-service-client-id
# RECS_BACKEND_SERVICE_CLIENT_SECRET=your-service-client-secret

# --- API server ---
# RECS_API_HOST=0.0.0.0
# RECS_API_PORT=8000
# RECS_API_DEFAULT_TOP_N=10
# RECS_API_MAX_TOP_N=50

# --- Dashboard ---
# RECS_DASHBOARD_API_BASE_URL=http://localhost:8000
